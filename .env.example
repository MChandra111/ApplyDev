# LLM providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Agent tools & infrastructure
TAVILY_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=applydev-resume
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings: hosted by Pinecone Inference (no separate OpenAI key required)
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024

# RAG chunking (characters — tune in Phase 2 experiments)
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=applydev
LANGCHAIN_TRACING_V2=true

# Backend (optional overrides)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend → backend URL (used by Vite in dev)
VITE_API_URL=http://localhost:8000
